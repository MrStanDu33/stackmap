{
  "name": "stackmap",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted documentation for your infrastructure, shown as interactive graphs.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.{css,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "commit": "gitmoji -c",
    "prepare": "husky"
  },
  "gitmoji": {
    "autoAdd": false,
    "emojiFormat": "emoji",
    "scopePrompt": false,
    "messagePrompt": true,
    "capitalizeTitle": true,
    "gitmojisUrl": "https://gitmoji.dev/api/gitmojis"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "nuxt": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "gitmoji-cli": "^9.7.0",
    "gitmojis": "^3.15.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
