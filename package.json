{
  "name": "stackmap",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted documentation for your infrastructure, shown as interactive graphs.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.{css,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --project scripts --project unit",
    "commit": "gitmoji -c",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:unit": "vitest run --project scripts --project unit",
    "test:stories": "vitest run --project 'storybook:*'",
    "release:prepare": "node scripts/release/prepare.mjs",
    "check:stories": "node scripts/checks/check-story-coverage.mjs",
    "test:mutation": "stryker run",
    "test:integration": "vitest run --project integration",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "db:test:up": "docker compose -f compose.dev.yaml --profile test up -d --wait postgres-test",
    "db:test:stop": "docker compose -f compose.dev.yaml --profile test stop postgres-test"
  },
  "gitmoji": {
    "autoAdd": false,
    "emojiFormat": "emoji",
    "scopePrompt": false,
    "messagePrompt": true,
    "capitalizeTitle": true,
    "gitmojisUrl": "https://gitmoji.dev/api/gitmojis"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "better-sqlite3": "^13.0.3",
    "culori": "^4.0.2",
    "kysely": "^0.29.6",
    "nuxt": "^4.6.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@nuxt/eslint": "^1.17.0",
    "@storybook/addon-a11y": "~10.6.1",
    "@storybook/addon-docs": "~10.6.1",
    "@storybook/addon-mcp": "~10.6.1",
    "@storybook/addon-vitest": "~10.6.1",
    "@storybook/vue3-vite": "~10.6.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "~10.6.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "gitmoji-cli": "^9.7.0",
    "gitmojis": "^3.15.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "postcss-html": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "~10.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "~8.3.4",
    "vitest": "^5.0.3",
    "vue-i18n": "11.4.13",
    "vue-tsc": "^3.3.12"
  }
}
