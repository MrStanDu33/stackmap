# Copy to .env for local development. Every variable is optional unless stated.

# Database. Defaults to SQLite in ./data/stackmap.sqlite.
# Postgres example: postgres://stackmap:stackmap@localhost:5432/stackmap
DATABASE_URL=

# Session signing secret. Generated into DATA_DIR/auth-secret on first start when empty.
BETTER_AUTH_SECRET=

# Public URL of this instance, used for links and cookies. Requests from another origin are refused, and cookies are
# Secure when it is https.
BETTER_AUTH_URL=http://localhost:3000

# true behind a reverse proxy that sets X-Forwarded-For: sign-in attempts are then limited per client address.
# Leave it unset otherwise, since anyone can send the header.
# TRUST_PROXY=true

# Integration tests on Postgres (`pnpm db:test:up` starts one on port 55432). Without it they run on SQLite only.
# The role needs CREATEDB: each test worker uses a database of its own, `<database>_<worker>`.
# TEST_POSTGRES_URL=postgres://stackmap:stackmap@localhost:55432/stackmap_test

# true, 1, yes or on seeds the fictional demo stack into a `demo` workspace at start when it is missing (a deleted one
# comes back). Off by default: /setup offers it.
# STACKMAP_DEMO=true

# selfhost | cloud
DEPLOYMENT_MODE=selfhost

# Minutes during which /setup accepts the first admin after each start, while no account exists (1 to 1440).
SETUP_TIMEOUT_MINUTES=15

# Docker only: user and group that own /data.
PUID=1000
PGID=1000
