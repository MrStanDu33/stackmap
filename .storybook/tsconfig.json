{
  // Storybook runs the app's components with Vite in the browser (preview) and in Node (main).
  "extends": "../.nuxt/tsconfig.app.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  // The built-in extensions' layer components (their inventory forms) and their stories are typechecked here.
  // Nitro's auto-imports: route types ($fetch) reach the server routes, which use them.
  "include": [
    "./**/*.ts",
    "./**/*.vue",
    "../extensions/*/app/**/*.ts",
    "../extensions/*/app/**/*.vue",
    "../app/vue-shim.d.ts",
    "../.nuxt/types/nitro-imports.d.ts"
  ]
}
