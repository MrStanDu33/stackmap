{
  // Storybook runs the app's components with Vite in the browser (preview) and in Node (main).
  "extends": "../.nuxt/tsconfig.app.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  // Nitro's auto-imports: route types ($fetch) reach the server routes, which use them.
  "include": ["./**/*.ts", "./**/*.vue", "../app/vue-shim.d.ts", "../.nuxt/types/nitro-imports.d.ts"]
}
