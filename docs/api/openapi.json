{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "Stackmap API",
    "summary": "Document your infrastructure: hosts, services, DNS, proxies and the flows between them.",
    "description": "Stackmap documents your infrastructure (hosts, services, DNS, proxies, VPNs) and the flows between\nthem. Every route is generated from its contract, so this reference is always the API itself.\n\n## Errors\n\nErrors follow [RFC 9457 Problem Details](https://www.rfc-editor.org/rfc/rfc9457), as `application/problem+json`:\n`type`, `title`, `status`, `detail` and `instance`, plus a stable `code` and, for invalid input, `issues`.\nTranslate errors with `code`, not with `title` or `detail`.\n\n## Roles\n\nEach operation states the role it needs (`x-required-role`): `viewer`, `editor`, `admin` or `owner` in a\nworkspace, or `public`. Roles are enforced once accounts exist.\n\n## Strings\n\nNames and labels in responses are i18n keys, such as `extensions.core.name`: the interface translates them.\n\n## Versioning\n\n`info.version` is the version of the API, raised on breaking changes, not with every release of Stackmap.",
    "version": "1",
    "contact": {
      "name": "Stackmap",
      "url": "https://github.com/MrStanDu33/stackmap/issues"
    },
    "license": {
      "name": "All rights reserved",
      "url": "https://github.com/MrStanDu33/stackmap/blob/develop/LICENSE"
    }
  },
  "servers": [
    {
      "url": "{scheme}://{host}",
      "description": "A Stackmap instance",
      "variables": {
        "scheme": {
          "default": "http",
          "enum": [
            "http",
            "https"
          ],
          "description": "`https` behind a TLS reverse proxy"
        },
        "host": {
          "default": "localhost:3000",
          "description": "Host name and port of your Stackmap instance"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Extensions",
      "description": "The installed extensions: what they add (kinds, languages), their state, and their diagnostics.",
      "externalDocs": {
        "description": "Extensions in the architecture",
        "url": "https://github.com/MrStanDu33/stackmap/blob/develop/docs/ARCHITECTURE.md#extensions"
      }
    },
    {
      "name": "System",
      "description": "The instance itself: whether it is up, and the description of this API."
    }
  ],
  "externalDocs": {
    "description": "Architecture",
    "url": "https://github.com/MrStanDu33/stackmap/blob/develop/docs/ARCHITECTURE.md"
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check that the app and its database are up",
        "description": "For the Docker healthcheck and uptime monitors: answers 200 when the app and its database answer, 503 otherwise. Why the database does not answer is in the server logs, never in the response.\n\nPublic: anyone can call it.",
        "tags": [
          "System"
        ],
        "x-required-role": "public",
        "responses": {
          "200": {
            "description": "The app and its database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "examples": {
                  "up": {
                    "summary": "Everything is up",
                    "value": {
                      "status": "ok",
                      "version": "1.4.0",
                      "database": "ok"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "The database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "examples": {
                  "databaseDown": {
                    "summary": "The database is down",
                    "value": {
                      "status": "error",
                      "version": "1.4.0",
                      "database": "error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Get this OpenAPI document",
        "description": "The OpenAPI 3.1 description of this API, generated from the contracts of its routes. `/api/docs` shows it as a browsable reference.\n\nPublic: anyone can call it.",
        "tags": [
          "System"
        ],
        "x-required-role": "public",
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document of the API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiDocument"
                },
                "examples": {
                  "minimal": {
                    "summary": "The start of the document",
                    "value": {
                      "openapi": "3.1.1",
                      "info": {
                        "title": "Stackmap API",
                        "version": "1"
                      },
                      "paths": {}
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/extensions": {
      "get": {
        "operationId": "listExtensions",
        "summary": "List the installed extensions",
        "description": "Every installed extension, dependencies first, with what it adds. Strings are i18n keys: the interface translates them. The interface builds its kinds, icons and languages from this list.\n\nRequires the viewer role.",
        "tags": [
          "Extensions"
        ],
        "x-required-role": "viewer",
        "responses": {
          "200": {
            "description": "The installed extensions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "extensions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Extension"
                      },
                      "description": "Dependencies first, then by id"
                    }
                  },
                  "required": [
                    "extensions"
                  ],
                  "additionalProperties": false
                },
                "examples": {
                  "core": {
                    "summary": "Only the core",
                    "value": {
                      "extensions": [
                        {
                          "id": "core",
                          "version": "1.4.0",
                          "name": "extensions.core.name",
                          "description": "extensions.core.description",
                          "icon": "i-lucide-layers",
                          "alwaysOn": true,
                          "dependsOn": [],
                          "state": "active",
                          "enabled": true,
                          "kinds": {
                            "host": [],
                            "network": [
                              {
                                "id": "lan",
                                "label": "extensions.core.kinds.network.lan",
                                "icon": "i-lucide-network"
                              }
                            ],
                            "service": [],
                            "protocol": []
                          },
                          "locales": []
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/extensions/diagnostics": {
      "get": {
        "operationId": "getExtensionDiagnostics",
        "summary": "Diagnose the installed extensions",
        "description": "For admins, extension authors and maintainers: each extension's state and errors, the code it runs, its hooks, and every language's translation coverage, missing keys and conflicts.\n\nRequires the admin role.",
        "tags": [
          "Extensions"
        ],
        "x-required-role": "admin",
        "responses": {
          "200": {
            "description": "The extensions and languages, with their diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionDiagnostics"
                },
                "examples": {
                  "failedExtension": {
                    "summary": "An extension that failed, and a German pack",
                    "value": {
                      "extensions": [
                        {
                          "id": "vpn",
                          "version": "1.0.0",
                          "state": "failed",
                          "errors": [
                            "depends on \"tls\", which is not installed"
                          ],
                          "code": {
                            "server": true,
                            "client": false
                          },
                          "hooks": {
                            "provides": [
                              "vpn:peer-added"
                            ],
                            "handles": [
                              "app:ready"
                            ]
                          }
                        }
                      ],
                      "languages": [
                        {
                          "code": "de",
                          "language": "de-DE",
                          "name": "Deutsch",
                          "coverage": 0.98,
                          "missing": [
                            "extensions.vpn.name"
                          ],
                          "conflicts": [
                            {
                              "key": "app.name",
                              "winner": null,
                              "ignored": [
                                "german-pack"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "description": "`ok` when the app and its database answer",
            "examples": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
            "description": "The version of Stackmap running",
            "examples": [
              "1.4.0"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "description": "`ok` when the database answers a query",
            "examples": [
              "ok"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "database"
        ],
        "additionalProperties": false,
        "description": "Whether the app and its database are up",
        "examples": [
          {
            "status": "ok",
            "version": "1.4.0",
            "database": "ok"
          }
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^urn:stackmap:problem:[a-z_]+$",
            "description": "Identifies the kind of problem: `urn:stackmap:problem:<code>`",
            "examples": [
              "urn:stackmap:problem:validation_failed"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "A short summary of the kind of problem, the same for every occurrence",
            "examples": [
              "The request does not match the API contract"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "The HTTP status code",
            "examples": [
              400
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "description": "What went wrong this time, for people",
            "examples": [
              "The request does not match the API contract."
            ]
          },
          "instance": {
            "type": "string",
            "minLength": 1,
            "description": "The path of the request that failed",
            "examples": [
              "/api/things/abc"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "validation_failed",
              "payload_too_large",
              "unsupported_media_type",
              "internal_error",
              "invalid_response"
            ],
            "description": "The kind of problem, stable and machine-readable so the interface can translate it:\n\n- `validation_failed` (400): A path parameter, query parameter or body is invalid or missing; `issues` says which.\n- `payload_too_large` (413): The body is over 1 MiB.\n- `unsupported_media_type` (415): The body is not `application/json`.\n- `internal_error` (500): An unexpected error; the server logs have the details.\n- `invalid_response` (500): Outside production only: the server answered something its contract does not declare.",
            "examples": [
              "validation_failed"
            ]
          },
          "issues": {
            "description": "Every invalid value, for `validation_failed` and `invalid_response`",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemIssue"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "additionalProperties": false,
        "description": "An API error, as RFC 9457 Problem Details (`application/problem+json`)",
        "examples": [
          {
            "type": "urn:stackmap:problem:validation_failed",
            "title": "The request does not match the API contract",
            "status": 400,
            "detail": "The request does not match the API contract.",
            "instance": "/api/things/abc",
            "code": "validation_failed",
            "issues": [
              {
                "path": "params.id",
                "message": "Invalid string: must match pattern /^\\d+$/"
              }
            ]
          }
        ]
      },
      "ProblemIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Where: `params.<name>`, `query.<name>`, `body.<path>`, or `response.<path>` outside production",
            "examples": [
              "body.name"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "What is wrong there",
            "examples": [
              "Too small: expected string to have >=1 characters"
            ]
          }
        },
        "required": [
          "path",
          "message"
        ],
        "additionalProperties": false,
        "description": "One invalid value",
        "examples": [
          {
            "path": "body.name",
            "message": "Too small: expected string to have >=1 characters"
          }
        ]
      },
      "OpenApiDocument": {
        "type": "object",
        "properties": {
          "openapi": {
            "type": "string",
            "minLength": 1,
            "description": "The version of the OpenAPI specification",
            "examples": [
              "3.1.1"
            ]
          },
          "info": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "The API's title, version, description, contact and license"
          },
          "paths": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "Every operation, by path and method"
          }
        },
        "required": [
          "openapi",
          "info",
          "paths"
        ],
        "additionalProperties": {},
        "description": "An OpenAPI 3.1 document",
        "examples": [
          {
            "openapi": "3.1.1",
            "info": {
              "title": "Stackmap API",
              "version": "1"
            },
            "paths": {}
          }
        ]
      },
      "Extension": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Unique, kebab-case",
            "examples": [
              "core"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
            "description": "Its semantic version",
            "examples": [
              "1.4.0"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "i18n key of its name",
            "examples": [
              "extensions.core.name"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "i18n key of what it adds",
            "examples": [
              "extensions.core.description"
            ]
          },
          "icon": {
            "description": "A Lucide icon name (`i-lucide-…`) or the path of an image the extension ships; absent when there is none or the app cannot show it (the interface then shows a generic icon)",
            "examples": [
              "i-lucide-layers"
            ],
            "type": "string",
            "minLength": 1
          },
          "alwaysOn": {
            "type": "boolean",
            "description": "Whether it can never be turned off (the core)",
            "examples": [
              true
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "description": "Ids of the extensions it needs"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "failed"
            ],
            "description": "`failed` when it does not fit with the others or its setup failed: it then contributes nothing",
            "examples": [
              "active"
            ]
          },
          "enabled": {
            "type": "boolean",
            "description": "Always true until extensions can be turned off per workspace",
            "examples": [
              true
            ]
          },
          "kinds": {
            "type": "object",
            "properties": {
              "host": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                },
                "description": "Kinds it adds to hosts"
              },
              "network": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                },
                "description": "Kinds it adds to networks"
              },
              "service": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                },
                "description": "Kinds it adds to services"
              },
              "protocol": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                },
                "description": "Kinds it adds to flows (protocols)"
              }
            },
            "required": [
              "host",
              "network",
              "service",
              "protocol"
            ],
            "additionalProperties": false,
            "description": "Kinds it adds, by core entity; empty when it failed"
          },
          "locales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionLocale"
            },
            "description": "Languages it adds; empty when it failed"
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "description",
          "alwaysOn",
          "dependsOn",
          "state",
          "enabled",
          "kinds",
          "locales"
        ],
        "additionalProperties": false,
        "description": "An installed extension",
        "examples": [
          {
            "id": "core",
            "version": "1.4.0",
            "name": "extensions.core.name",
            "description": "extensions.core.description",
            "icon": "i-lucide-layers",
            "alwaysOn": true,
            "dependsOn": [],
            "state": "active",
            "enabled": true,
            "kinds": {
              "host": [],
              "network": [
                {
                  "id": "lan",
                  "label": "extensions.core.kinds.network.lan",
                  "icon": "i-lucide-network"
                }
              ],
              "service": [],
              "protocol": []
            },
            "locales": []
          }
        ]
      },
      "ExtensionKind": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Stored in the database; unique per entity",
            "examples": [
              "lan"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "i18n key of its name",
            "examples": [
              "extensions.core.kinds.network.lan"
            ]
          },
          "icon": {
            "description": "A Lucide icon name (`i-lucide-…`) or the path of an image the extension ships; absent when there is none or the app cannot show it (the interface then shows a generic icon)",
            "examples": [
              "i-lucide-network"
            ],
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "description": "A kind an extension adds to a core entity",
        "examples": [
          {
            "id": "lan",
            "label": "extensions.core.kinds.network.lan",
            "icon": "i-lucide-network"
          }
        ]
      },
      "ExtensionLocale": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[A-Z][a-z]{3})?$",
            "description": "Locale code, as in settings",
            "examples": [
              "de"
            ]
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
            "description": "BCP 47 language tag",
            "examples": [
              "de-DE"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The language's name, in that language",
            "examples": [
              "Deutsch"
            ]
          }
        },
        "required": [
          "code",
          "language",
          "name"
        ],
        "additionalProperties": false,
        "description": "A language an extension adds",
        "examples": [
          {
            "code": "de",
            "language": "de-DE",
            "name": "Deutsch"
          }
        ]
      },
      "ExtensionDiagnostics": {
        "type": "object",
        "properties": {
          "extensions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "description": "Its id",
                  "examples": [
                    "vpn"
                  ]
                },
                "version": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
                  "description": "Its version",
                  "examples": [
                    "1.0.0"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "active",
                    "failed"
                  ],
                  "description": "`failed` when it does not fit with the others or its setup failed: it then contributes nothing",
                  "examples": [
                    "active"
                  ]
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Why it failed (credentials masked; the server logs have the full errors)"
                },
                "code": {
                  "type": "object",
                  "properties": {
                    "server": {
                      "type": "boolean",
                      "description": "Whether it runs code on the server",
                      "examples": [
                        true
                      ]
                    },
                    "client": {
                      "type": "boolean",
                      "description": "Whether it runs code in the browser",
                      "examples": [
                        false
                      ]
                    }
                  },
                  "required": [
                    "server",
                    "client"
                  ],
                  "additionalProperties": false,
                  "description": "The code it declares, of which users are warned before installing it"
                },
                "hooks": {
                  "type": "object",
                  "properties": {
                    "provides": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "Hooks it declares, as `<id>:<name>`"
                    },
                    "handles": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "Server hooks it handles"
                    }
                  },
                  "required": [
                    "provides",
                    "handles"
                  ],
                  "additionalProperties": false,
                  "description": "Its hooks"
                }
              },
              "required": [
                "id",
                "version",
                "state",
                "errors",
                "code",
                "hooks"
              ],
              "additionalProperties": false
            },
            "description": "Every installed extension, in registry order"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[A-Z][a-z]{3})?$",
                  "description": "Locale code, as in settings",
                  "examples": [
                    "de"
                  ]
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
                  "description": "BCP 47 language tag",
                  "examples": [
                    "de-DE"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The language's name, in that language",
                  "examples": [
                    "Deutsch"
                  ]
                },
                "coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Share of the English keys translated",
                  "examples": [
                    0.98
                  ]
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Keys it does not translate: they show in English"
                },
                "conflicts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The key translated more than once",
                        "examples": [
                          "app.name"
                        ]
                      },
                      "winner": {
                        "description": "Whose translation is used; `null`: the app",
                        "examples": [
                          null
                        ],
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ignored": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "description": "Whose translations are ignored"
                      }
                    },
                    "required": [
                      "key",
                      "winner",
                      "ignored"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Keys translated by more than one extension, and which translation wins"
                }
              },
              "required": [
                "code",
                "language",
                "name",
                "coverage",
                "missing",
                "conflicts"
              ],
              "additionalProperties": false
            },
            "description": "Every language, with its translation coverage"
          }
        },
        "required": [
          "extensions",
          "languages"
        ],
        "additionalProperties": false,
        "description": "What each extension does, why it failed, and translation coverage",
        "examples": [
          {
            "extensions": [
              {
                "id": "vpn",
                "version": "1.0.0",
                "state": "failed",
                "errors": [
                  "depends on \"tls\", which is not installed"
                ],
                "code": {
                  "server": true,
                  "client": false
                },
                "hooks": {
                  "provides": [
                    "vpn:peer-added"
                  ],
                  "handles": [
                    "app:ready"
                  ]
                }
              }
            ],
            "languages": [
              {
                "code": "de",
                "language": "de-DE",
                "name": "Deutsch",
                "coverage": 0.98,
                "missing": [
                  "extensions.vpn.name"
                ],
                "conflicts": [
                  {
                    "key": "app.name",
                    "winner": null,
                    "ignored": [
                      "german-pack"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "responses": {
      "InternalError": {
        "description": "An unexpected error or, outside production, a response that does not match its contract",
        "content": {
          "application/problem+json": {
            "schema": {
