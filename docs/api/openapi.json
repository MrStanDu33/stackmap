{
  "openapi": "3.1.0",
  "info": {
    "title": "Stackmap API",
    "version": "1",
    "description": "Self-hosted documentation for your infrastructure. Every route is generated from its contract."
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check that the app and its database are up",
        "tags": [
          "System"
        ],
        "x-required-role": "public",
        "responses": {
          "200": {
            "description": "The app and its database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Get this OpenAPI document",
        "tags": [
          "System"
        ],
        "x-required-role": "public",
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document of the API",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "openapi": {
                      "type": "string"
                    },
                    "info": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    },
                    "paths": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ],
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions": {
      "get": {
        "operationId": "listExtensions",
        "summary": "List the installed extensions",
        "description": "Dependencies come before the extensions that need them. Strings are i18n keys.",
        "tags": [
          "Extensions"
        ],
        "x-required-role": "viewer",
        "responses": {
          "200": {
            "description": "The installed extensions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "extensions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Extension"
                      }
                    }
                  },
                  "required": [
                    "extensions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/diagnostics": {
      "get": {
        "operationId": "getExtensionDiagnostics",
        "summary": "Diagnose the installed extensions",
        "description": "For admins, extension authors and maintainers: states, errors, code, hooks and translation coverage.",
        "tags": [
          "Extensions"
        ],
        "x-required-role": "admin",
        "responses": {
          "200": {
            "description": "The extensions and languages, with their diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionDiagnostics"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "version": {
            "type": "string"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "database"
        ],
        "additionalProperties": false,
        "description": "Whether the app and its database are up"
      },
      "Extension": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "i18n key"
          },
          "description": {
            "type": "string",
            "description": "i18n key"
          },
          "icon": {
            "description": "A Lucide icon name or an image path; absent when unknown",
            "type": "string"
          },
          "alwaysOn": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "failed"
            ],
            "description": "A failed extension contributes nothing"
          },
          "enabled": {
            "type": "boolean",
            "description": "Always true until extensions can be turned off per workspace"
          },
          "kinds": {
            "type": "object",
            "properties": {
              "host": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                }
              },
              "network": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                }
              },
              "service": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                }
              },
              "protocol": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                }
              }
            },
            "required": [
              "host",
              "network",
              "service",
              "protocol"
            ],
            "additionalProperties": false
          },
          "locales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionLocale"
            }
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "description",
          "alwaysOn",
          "dependsOn",
          "state",
          "enabled",
          "kinds",
          "locales"
        ],
        "additionalProperties": false,
        "description": "An installed extension"
      },
      "ExtensionKind": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "i18n key"
          },
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "description": "A kind an extension adds to a core entity"
      },
      "ExtensionLocale": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "BCP 47 language tag"
          },
          "name": {
            "type": "string",
            "description": "The language's name in that language"
          }
        },
        "required": [
          "code",
          "language",
          "name"
        ],
        "additionalProperties": false,
        "description": "A language an extension adds"
      },
      "ExtensionDiagnostics": {
        "type": "object",
        "properties": {
          "extensions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "active",
                    "failed"
                  ],
                  "description": "A failed extension contributes nothing"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "code": {
                  "type": "object",
                  "properties": {
                    "server": {
                      "type": "boolean"
                    },
                    "client": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "server",
                    "client"
                  ],
                  "additionalProperties": false
                },
                "hooks": {
                  "type": "object",
                  "properties": {
                    "provides": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Hooks the extension declares, as <id>:<name>"
                    },
                    "handles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Server hooks the extension handles"
                    }
                  },
                  "required": [
                    "provides",
                    "handles"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "version",
                "state",
                "errors",
                "code",
                "hooks"
              ],
              "additionalProperties": false
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "language": {
                  "type": "string",
                  "description": "BCP 47 language tag"
                },
                "name": {
                  "type": "string",
                  "description": "The language's name in that language"
                },
                "coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Share of the English keys translated"
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "conflicts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "winner": {
                        "description": "The extension whose translation is used; null: the app",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ignored": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "required": [
                      "key",
                      "winner",
                      "ignored"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "code",
                "language",
                "name",
                "coverage",
                "missing",
                "conflicts"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "extensions",
          "languages"
        ],
        "additionalProperties": false,
        "description": "What each extension does, why it failed, and translation coverage"
      }
    }
  }
}
