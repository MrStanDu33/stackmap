{
  "openapi": "3.1.0",
  "info": {
    "title": "Stackmap API",
    "version": "1",
    "description": "Self-hosted documentation for your infrastructure. Every route is generated from its contract."
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check that the app and its database are up",
        "tags": [
          "System"
        ],
        "x-required-role": "public",
        "responses": {
          "200": {
            "description": "The app and its database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Get this OpenAPI document",
        "tags": [
          "System"
        ],
        "x-required-role": "public",
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document of the API",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "openapi": {
                      "type": "string"
                    },
                    "info": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    },
                    "paths": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ],
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions": {
      "get": {
        "operationId": "listExtensions",
        "summary": "List the installed extensions",
        "description": "Dependencies come before the extensions that need them. Strings are i18n keys.",
        "tags": [
          "Extensions"
        ],
        "x-required-role": "viewer",
        "responses": {
          "200": {
            "description": "The installed extensions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "extensions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Extension"
                      }
                    }
                  },
                  "required": [
                    "extensions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "version": {
            "type": "string"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "database"
        ],
        "additionalProperties": false,
        "description": "Whether the app and its database are up"
      },
      "Extension": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "i18n key"
          },
          "description": {
            "type": "string",
            "description": "i18n key"
          },
          "icon": {
            "description": "A Lucide icon name or an image path; absent when unknown",
            "type": "string"
          },
          "alwaysOn": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean",
            "description": "Always true until extensions can be turned off per workspace"
          },
          "kinds": {
            "type": "object",
            "properties": {
              "host": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                }
              },
              "network": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                }
              },
              "service": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                }
              },
              "protocol": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExtensionKind"
                }
              }
            },
            "required": [
              "host",
              "network",
              "service",
              "protocol"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "description",
          "alwaysOn",
          "dependsOn",
          "enabled",
          "kinds"
        ],
        "additionalProperties": false,
        "description": "An installed extension"
      },
      "ExtensionKind": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "i18n key"
          },
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "description": "A kind an extension adds to a core entity"
      }
    }
  }
}
